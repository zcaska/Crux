{
  "name": "@project-context/core",
  "version": "5.0.0",
  "description": "Universal Project Context OS — Portable, repository-local multi-agent context and MCP server",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./*": "./*"
  },
  "bin": {
